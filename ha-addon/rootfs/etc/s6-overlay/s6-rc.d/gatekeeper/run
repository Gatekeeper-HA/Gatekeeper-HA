#!/usr/bin/with-contenv bashio
# shellcheck shell=bash

bashio::log.info "Starting Gatekeeper AI Doorbell..."

# Each add-on option is read by Gatekeeper from the upper-cased environment
# variable of the same name (camera_name -> CAMERA_NAME).
for option in \
    camera_name mqtt_host mqtt_port mqtt_topic \
    audio_rtsp_url go2rtc_api go2rtc_talk_stream \
    dwell_seconds listen_seconds session_ttl_seconds sweep_interval_seconds \
    cooldown_seconds visit_timeout_seconds audio_retention_days event_log_retention_days \
    whisper_model whisper_compute_type kokoro_voice \
    greeting reply_delivery reply_sales reply_maintenance reply_generic reply_no_answer \
    log_level log_format; do
    value="$(bashio::config "${option}")"
    export "${option^^}=${value}"
done

# Persistent storage under /data (survives add-on restarts and updates)
export AUDIO_DIR="/data/audio"
export LOG_DIR="/data/logs"

# Cache Kokoro/Whisper model weights in persistent storage
export HF_HOME="/data/cache/huggingface"
export TRANSFORMERS_CACHE="/data/cache/huggingface"
export XDG_CACHE_HOME="/data/cache"

bashio::log.info "Camera: ${CAMERA_NAME}"
bashio::log.info "MQTT: ${MQTT_HOST}:${MQTT_PORT}"
bashio::log.info "go2rtc API: ${GO2RTC_API}"
bashio::log.info "Whisper model: ${WHISPER_MODEL} (${WHISPER_COMPUTE_TYPE})"
bashio::log.info "Voice: ${KOKORO_VOICE}"

exec /opt/venv/bin/python -m gatekeeper
